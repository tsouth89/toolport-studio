# Toolport integration

# Override automatic Toolport gateway discovery.
# TOOLPORT_GATEWAY_PATH=C:\Program Files\Toolport\toolport-gateway.exe

# Set to "off" to disable automatic Toolport MCP injection.
# TOOLPORT_STUDIO_TOOLPORT_MCP=off

# Use a remote or explicitly managed Streamable HTTP endpoint instead of the
# local gateway. Keep real bearer tokens out of source control.
# TOOLPORT_STUDIO_MCP_URL=http://127.0.0.1:8765/mcp
# TOOLPORT_STUDIO_MCP_TOKEN=

# Desktop release signing (macOS). Read only by the local packaging scripts —
# the Windows release workflow signs through Azure Trusted Signing and needs
# neither of these.
# TOOLPORT_STUDIO_APPLE_TEAM_ID=ABC1234567
# TOOLPORT_STUDIO_MACOS_PROVISIONING_PROFILE=/absolute/path/to/toolport-studio.provisionprofile

# Windows Azure Trusted Signing:
# AZURE_TRUSTED_SIGNING_ENDPOINT=
# AZURE_TRUSTED_SIGNING_ACCOUNT_NAME=
# AZURE_TRUSTED_SIGNING_CERTIFICATE_PROFILE_NAME=
# AZURE_TRUSTED_SIGNING_PUBLISHER_NAME=
# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=
